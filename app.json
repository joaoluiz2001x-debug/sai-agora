{
  "expo": {
    "name": "Sai Agora",
    "slug": "sai-agora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.saiagora.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos a sua localização para encontrar as paragens perto de si. Não é guardada."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1A3C"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pt.saiagora.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-notifications"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1A3C"
    }
  }
}